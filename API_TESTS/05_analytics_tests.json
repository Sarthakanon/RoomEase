{
  "info": {
    "name": "Analytics API Tests",
    "description": "Test cases for analytics and AI-powered insights endpoints",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "default"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "default"
    },
    {
      "key": "roomspaceId",
      "value": "",
      "type": "default"
    }
  ],
  "item": [
    {
      "name": "Get Analytics Summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/analytics/summary?start_date=2024-01-01&end_date=2024-12-31",
          "host": ["{{baseUrl}}"],
          "path": ["api", "analytics", "summary"],
          "query": [
            {
              "key": "start_date",
              "value": "2024-01-01"
            },
            {
              "key": "end_date",
              "value": "2024-12-31"
            }
          ]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Response has summary data', function () { const json = pm.response.json(); pm.expect(json.success).to.be.true; pm.expect(json.data).to.be.an('object'); });"
    },
    {
      "name": "Get Analytics Summary for Roomspace",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/analytics/summary?roomspace_id={{roomspaceId}}&start_date=2024-01-01&end_date=2024-12-31",
          "host": ["{{baseUrl}}"],
          "path": ["api", "analytics", "summary"],
          "query": [
            {
              "key": "roomspace_id",
              "value": "{{roomspaceId}}"
            },
            {
              "key": "start_date",
              "value": "2024-01-01"
            },
            {
              "key": "end_date",
              "value": "2024-12-31"
            }
          ]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Response has roomspace summary', function () { pm.expect(pm.response.json().data).to.be.an('object'); });"
    },
