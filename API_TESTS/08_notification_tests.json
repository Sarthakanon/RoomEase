{
  "info": {
    "name": "Notification System API Tests",
    "description": "Test cases for notification management and join request endpoints",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "default"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "default"
    },
    {
      "key": "notificationId",
      "value": "",
      "type": "default"
    },
    {
      "key": "joinRequestId",
      "value": "",
      "type": "default"
    },
    {
      "key": "roomspaceId",
      "value": "",
      "type": "default"
    }
  ],
  "item": [
    {
      "name": "Get User Notifications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notifications"]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Response has notifications array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
    },
    {
      "name": "Mark Notification as Read",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications/{{notificationId}}/read",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notifications", "{{notificationId}}", "read"]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Notification marked as read', function () { pm.expect(pm.response.json().message).to.include('read'); });"
    },
    {
      "name": "Send Payment Reminder",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipient_uid\": \"debtor_user_uid\",\n  \"roomspace_id\": \"{{roomspaceId}}\",\n  \"amount\": 125.50\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/notifications/send-reminder",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notifications", "send-reminder"]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Reminder sent successfully', function () { pm.expect(pm.response.json().message).to.include('sent'); });"
    },
    {
      "name": "Get Join Requests",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/join-requests",
          "host": ["{{baseUrl}}"],
          "path": ["api", "join-requests"]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Response has join requests', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
    },
    {
      "name": "Get Pending Join Request",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/join-requests/pending",
          "host": ["{{baseUrl}}"],
          "path": ["api", "join-requests", "pending"]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Response has pending request data', function () { const json = pm.response.json(); pm.expect(json.success).to.be.true; });"
    },
    {
      "name": "Accept Join Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accept\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/join-requests/{{joinRequestId}}/process",
          "host": ["{{baseUrl}}"],
          "path": ["api", "join-requests", "{{joinRequestId}}", "process"]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Join request accepted', function () { pm.expect(pm.response.json().message).to.include('accepted'); });"
    },
    {
      "name": "Reject Join Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accept\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/join-requests/{{joinRequestId}}/process",
          "host": ["{{baseUrl}}"],
          "path": ["api", "join-requests", "{{joinRequestId}}", "process"]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Join request rejected', function () { pm.expect(pm.response.json().message).to.include('rejected'); });"
    },
    {
      "name": "Send Payment Reminder - Invalid Data",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipient_uid\": \"debtor_user_uid\",\n  \"amount\": -50.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/notifications/send-reminder",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notifications", "send-reminder"]
        }
      },
      "tests": "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
    },
    {
      "name": "Mark Notification as Read - Invalid ID",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications/99999/read",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notifications", "99999", "read"]
        }
      },
      "tests": "pm.test('Status code is 400 or 404', function () { pm.expect(pm.response.code).to.be.oneOf([400, 404]); });"
    },
    {
      "name": "Process Join Request - Invalid ID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accept\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/join-requests/invalid-uuid/process",
          "host": ["{{baseUrl}}"],
          "path": ["api", "join-requests", "invalid-uuid", "process"]
        }
      },
      "tests": "pm.test('Status code is 400 or 404', function () { pm.expect(pm.response.code).to.be.oneOf([400, 404]); });"
    }
  ]
}