{
  "info": {
    "name": "User Management API Tests",
    "description": "Test cases for user profile management endpoints",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "default"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "default"
    }
  ],
  "item": [
    {
      "name": "Get User Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/user/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "user", "profile"]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Response has user data', function () { pm.expect(pm.response.json().data).to.have.property('firebase_uid'); });"
    },
    {
      "name": "Update User Profile",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Test User\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/user/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "user", "profile"]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Profile updated successfully', function () { pm.expect(pm.response.json().message).to.include('updated'); });"
    },
    {
      "name": "Get User Roomspace Count",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/user/roomspaces/count",
          "host": ["{{baseUrl}}"],
          "path": ["api", "user", "roomspaces", "count"]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Response has count and limit', function () { const json = pm.response.json(); pm.expect(json).to.have.property('count'); pm.expect(json).to.have.property('limit'); });"
    },
    {
      "name": "Get Profile - Unauthorized",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/user/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "user", "profile"]
        }
      },
      "tests": "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });"
    },
    {
      "name": "Update Profile - Invalid Data",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"invalid_field\": \"test\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/user/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "user", "profile"]
        }
      },
      "tests": "pm.test('Status code is 200 or 400', function () { pm.expect(pm.response.code).to.be.oneOf([200, 400]); });"
    }
  ]
}