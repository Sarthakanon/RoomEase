{
  "info": {
    "name": "Balance Management API Tests",
    "description": "Test cases for balance calculations, settlements, and payment tracking endpoints",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "default"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "default"
    },
    {
      "key": "roomspaceId",
      "value": "",
      "type": "default"
    },
    {
      "key": "userId",
      "value": "",
      "type": "default"
    }
  ],
  "item": [
    {
      "name": "Get Roomspace Balances",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/roomspaces/{{roomspaceId}}/balances",
          "host": ["{{baseUrl}}"],
          "path": ["api", "roomspaces", "{{roomspaceId}}", "balances"]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Response has balance data', function () { pm.expect(pm.response.json().data).to.be.an('object'); });"
    },
    {
      "name": "Get User Balance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/roomspaces/{{roomspaceId}}/balances/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "roomspaces", "{{roomspaceId}}", "balances", "{{userId}}"]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Response has user balance', function () { pm.expect(pm.response.json().data).to.be.an('object'); });"
    },
    {
      "name": "Create Settlement",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_user_id\": \"user1_uid\",\n  \"to_user_id\": \"user2_uid\",\n  \"amount\": 50.00,\n  \"notes\": \"Payment for shared groceries\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/roomspaces/{{roomspaceId}}/settlements",
          "host": ["{{baseUrl}}"],
          "path": ["api", "roomspaces", "{{roomspaceId}}", "settlements"]
        }
      },
      "tests": "pm.test('Status code is 201', function () { pm.response.to.have.status(201); }); pm.test('Settlement created successfully', function () { pm.expect(pm.response.json().message).to.include('recorded'); });"
    },
    {
      "name": "Get Settlement History",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/roomspaces/{{roomspaceId}}/settlements?limit=10&offset=0",
          "host": ["{{baseUrl}}"],
          "path": ["api", "roomspaces", "{{roomspaceId}}", "settlements"],
          "query": [
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "offset",
              "value": "0"
            }
          ]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Response has settlement history', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
    },
    {
      "name": "Get Settlement Suggestions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/roomspaces/{{roomspaceId}}/settlements/suggestions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "roomspaces", "{{roomspaceId}}", "settlements", "suggestions"]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Response has settlement suggestions', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
    },
    {
      "name": "Refresh Balance Cache",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/roomspaces/{{roomspaceId}}/balances/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["api", "roomspaces", "{{roomspaceId}}", "balances", "refresh"]
        }
      },
      "tests": "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); pm.test('Cache refreshed successfully', function () { pm.expect(pm.response.json().message).to.include('refreshed'); });"
    },
    {
      "name": "Create Settlement - Invalid Amount",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_user_id\": \"user1_uid\",\n  \"to_user_id\": \"user2_uid\",\n  \"amount\": -10.00,\n  \"notes\": \"Invalid negative amount\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/roomspaces/{{roomspaceId}}/settlements",
          "host": ["{{baseUrl}}"],
          "path": ["api", "roomspaces", "{{roomspaceId}}", "settlements"]
        }
      },
      "tests": "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
    },
    {
      "name": "Create Settlement - Missing Required Fields",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_user_id\": \"user1_uid\",\n  \"notes\": \"Missing to_user_id and amount\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/roomspaces/{{roomspaceId}}/settlements",
          "host": ["{{baseUrl}}"],
          "path": ["api", "roomspaces", "{{roomspaceId}}", "settlements"]
        }
      },
      "tests": "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
    },
    {
      "name": "Get Balance - Unauthorized Roomspace",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id={{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/roomspaces/invalid-roomspace-id/balances",
          "host": ["{{baseUrl}}"],
          "path": ["api", "roomspaces", "invalid-roomspace-id", "balances"]
        }
      },
      "tests": "pm.test('Status code is 403 or 404', function () { pm.expect(pm.response.code).to.be.oneOf([403, 404]); });"
    }
  ]
}