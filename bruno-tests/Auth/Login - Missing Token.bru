meta {
  name: Login - Missing Token
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "invalid_field": "test"
  }
}

assert {
  res.status: eq 400
  res.body.error: isDefined
}

tests {
  test("Missing token returns 400", function() {
    expect(res.status).to.equal(400);
    expect(res.body).to.have.property('error');
  });
  
  test("Error indicates invalid request body", function() {
    expect(res.body.error).to.include('Invalid request body');
  });
}