meta {
  name: Refresh Session
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/refresh
  body: none
  auth: none
}

headers {
  Cookie: session_id={{session_id}}
}

assert {
  res.status: eq 200
  res.body.message: isDefined
  res.body.expires_at: isDefined
}

tests {
  test("Session refresh successful", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property('message');
    expect(res.body).to.have.property('expires_at');
  });
  
  test("Refresh message is correct", function() {
    expect(res.body.message).to.equal('Session refreshed successfully');
  });
  
  test("Expires at is a valid date", function() {
    const expiresAt = new Date(res.body.expires_at);
    expect(expiresAt).to.be.a('date');
    expect(expiresAt.getTime()).to.be.greaterThan(Date.now());
  });
}