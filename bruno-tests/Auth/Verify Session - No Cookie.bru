meta {
  name: Verify Session - No Cookie
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/auth/verify
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.valid: eq false
}

tests {
  test("No session cookie returns invalid", function() {
    expect(res.status).to.equal(200);
    expect(res.body.valid).to.equal(false);
    expect(res.body).to.not.have.property('user_id');
    expect(res.body).to.not.have.property('email');
  });
}