meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firebase_token": "{{firebase_token}}"
  }
}

assert {
  res.status: eq 200
  res.body.user_id: isDefined
  res.body.email: isDefined
  res.body.session_id: isDefined
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("user_id", res.body.user_id);
    bru.setEnvVar("email", res.body.email);
    bru.setEnvVar("session_id", res.body.session_id);
  }
}

tests {
  test("Login successful", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property('user_id');
    expect(res.body).to.have.property('email');
    expect(res.body).to.have.property('session_id');
  });
  
  test("Response contains valid user data", function() {
    expect(res.body.user_id).to.be.a('string');
    expect(res.body.email).to.be.a('string');
    expect(res.body.session_id).to.be.a('string');
    expect(res.body.email).to.include('@');
  });
}