meta {
  name: DELETE /api/recurring-expenses/:template_id
  type: http
}

delete {
  url: {{baseUrl}}/api/recurring-expenses/{{template_id}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: session_id={{session_id}}
}

assert {
  res.status: oneOf 200 201 400 401 403 404 409 422 500
}

tests {
  test("status is handled", function() {
    expect([200,201,400,401,403,404,409,422,500]).to.include(res.status);
  });
}
