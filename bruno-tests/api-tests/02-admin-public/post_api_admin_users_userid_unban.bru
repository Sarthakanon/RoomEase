meta {
  name: POST /api/admin/users/:userId/unban
  type: http
}

post {
  url: {{baseUrl}}/api/admin/users/{{user_id}}/unban
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "note": "Fill body as required by this endpoint"
  }
}

assert {
  res.status: oneOf 200 201 400 401 403 404 409 422 500
}

tests {
  test("status is handled", function() {
    expect([200,201,400,401,403,404,409,422,500]).to.include(res.status);
  });
}
