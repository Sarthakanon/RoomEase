meta {
  name: POST /api/auth/login
  type: http
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firebase_token": "{{firebase_token}}"
  }
}

assert {
  res.status: oneOf 200 201 400 401 403 404 409 422 500
}

script:post-response {
  if (res.status === 200) {
    if (res.body.session_id) bru.setEnvVar("session_id", res.body.session_id);
    if (res.body.user_id) bru.setEnvVar("user_id", res.body.user_id);
  }
}

tests {
  test("status is handled", function() {
    expect([200,201,400,401,403,404,409,422,500]).to.include(res.status);
  });
}
