meta {
  name: GET /api/roomspaces/:id/balances/:userId
  type: http
}

get {
  url: {{baseUrl}}/api/roomspaces/{{roomspace_id}}/balances/{{user_id}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: session_id={{session_id}}
}

assert {
  res.status: oneOf 200 201 400 401 403 404 409 422 500
}

tests {
  test("status is handled", function() {
    expect([200,201,400,401,403,404,409,422,500]).to.include(res.status);
  });
}
