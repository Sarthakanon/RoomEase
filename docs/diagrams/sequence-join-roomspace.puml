@startuml Sequence Diagram - Join Roomspace (ROOM-F-2.0, ROOM-F-2.1)
!theme plain

title Sequence Diagram: Join Roomspace with Approval

actor Requester as requester
participant "Requester App" as reqApp
participant "Backend\n(Go/Gin)" as backend
database "PostgreSQL" as db
participant "Creator App" as creatorApp
actor Creator as creator

== Search Roomspace ==

requester -> reqApp : Enter invite code
requester -> reqApp : Tap "Search"

reqApp -> backend : GET /api/roomspaces/code/{code}

backend -> db : SELECT * FROM roomspaces\nWHERE invite_code = ?

alt Not Found
    db --> backend : Empty result
    backend --> reqApp : 404 Not Found
    reqApp --> requester : Show "Room not found"
else Found
    db --> backend : Roomspace data
    
    backend -> db : SELECT members WITH users\nWHERE roomspace_id = ?
    db --> backend : Members list
    
    backend --> reqApp : 200 OK\n{name, members, invite_code}
    reqApp --> requester : Display roomspace details
end

== Request to Join ==

requester -> reqApp : Tap "Join Roomspace"

reqApp -> backend : POST /api/roomspaces/code/{code}/join

backend -> db : Check if already member
alt Already Member
    backend --> reqApp : 400 "Already a member"
else Not Member
    backend -> db : Check pending request
    alt Has Pending Request
        backend --> reqApp : 400 "Request already pending"
    else No Pending Request
        backend -> db : INSERT INTO join_requests\n(roomspace_id, requester_uid, status='PENDING')
        db --> backend : request_id
        
        backend -> db : SELECT members FROM roomspace
        db --> backend : Member UIDs
        
        loop For each member
            backend -> db : INSERT INTO notifications\n(recipient_uid, type='JOIN_REQUEST',\ntitle, message)
        end
        
        backend --> reqApp : 200 OK\n{message: "Request sent"}
        reqApp --> requester : Show "Request Sent"\nNavigate to Pending screen
    end
end

== Process Join Request ==

creator -> creatorApp : Open Notifications
creatorApp -> backend : GET /api/join-requests
backend -> db : SELECT join_requests\nWHERE roomspace creator = user
db --> backend : Pending requests
backend --> creatorApp : {requests: [...]}
creatorApp --> creator : Display join requests

creator -> creatorApp : Tap "Accept" or "Reject"
creatorApp -> backend : POST /api/join-requests/{id}/process\n{accept: true/false}

alt Accept
    backend -> db : UPDATE join_requests\nSET status = 'ACCEPTED'
    backend -> db : INSERT INTO roomspace_members
    backend -> db : INSERT notification for requester\n(type='JOIN_ACCEPTED')
    backend --> creatorApp : 200 OK
    
    reqApp <-- backend : Push notification
    reqApp --> requester : "You've been accepted!"
    reqApp --> requester : Navigate to Home
else Reject
    backend -> db : UPDATE join_requests\nSET status = 'REJECTED'
    backend -> db : INSERT notification for requester\n(type='JOIN_REJECTED')
    backend --> creatorApp : 200 OK
    
    reqApp <-- backend : Push notification
    reqApp --> requester : "Request declined"
end

@enduml
