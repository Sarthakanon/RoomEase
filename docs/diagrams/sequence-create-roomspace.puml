@startuml Sequence Diagram - Create Roomspace (ROOM-F-1.0)
!theme plain

title Sequence Diagram: Create Roomspace (ROOM-F-1.0)

actor User as user
participant "Flutter App" as app
participant "Backend\n(Go/Gin)" as backend
database "PostgreSQL" as db

user -> app : Enter roomspace name
user -> app : Enter description (optional)
user -> app : Tap "Create Roomspace"

app -> app : Validate name not empty

app -> backend : POST /api/roomspaces\n{name, description}\nCookie: session_id

backend -> backend : Verify session from cookie

alt Session Invalid
    backend --> app : 401 Unauthorized
    app --> user : Redirect to Login
else Session Valid
    backend -> backend : Extract user_id from session
    
    backend -> backend : generateInviteCode()\n// 8-char alphanumeric
    
    loop Until unique code
        backend -> db : SELECT * FROM roomspaces\nWHERE invite_code = ?
        alt Code Exists
            backend -> backend : Generate new code
        else Code Unique
            backend -> backend : Use this code
        end
    end
    
    backend -> db : INSERT INTO roomspaces\n(name, description, invite_code, created_by)
    db --> backend : roomspace_id
    
    backend -> db : INSERT INTO roomspace_members\n(roomspace_id, firebase_uid, joined_at)
    db --> backend : Member added
    
    backend --> app : 201 Created\n{id, name, invite_code, members: [...]}
    
    app -> app : Show success dialog
    app --> user : Display invite code\n"ABC12345"
    
    user -> app : Tap "Copy Code"
    app -> app : Copy to clipboard
    app --> user : Show "Copied!" toast
    
    user -> app : Tap "Continue to Home"
    app --> user : Navigate to Home Dashboard
end

@enduml
