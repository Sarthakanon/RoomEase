@startuml Change Password Sequence Diagram

skinparam linetype ortho
skinparam sequenceMessageAlign center
skinparam BoxPadding 10

actor User
participant "Flutter App" as App
participant "Firebase Auth" as Firebase

User -> App: Navigate to Settings
activate App

User -> App: Click "Change Password"
App --> User: Show password dialog

User -> App: Enter current & new passwords
App -> App: Validate passwords\n(match, length >= 6)

alt Passwords Valid
    App -> Firebase: reauthenticateWithCredential()\n{email, current_password}
    activate Firebase
    
    alt Current Password Correct
        Firebase --> App: Reauthentication successful
        
        App -> Firebase: updatePassword(new_password)
        
        alt Password Updated
            Firebase --> App: Password changed
            deactivate Firebase
            
            App --> User: Show "Password changed successfully"
            App -> App: Close dialog
            
        else Update Failed
            Firebase --> App: FirebaseException
            deactivate Firebase
            App --> User: Show error message
        end
        
    else Current Password Wrong
        Firebase --> App: AuthException\n"Wrong password"
        deactivate Firebase
        App --> User: Show "Current password incorrect"
    end
    
else Validation Failed
    App --> User: Show validation errors\n(e.g., "Passwords don't match")
end

deactivate App

@enduml
