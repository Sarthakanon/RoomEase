# Server Configuration
PORT=8080
ENVIRONMENT=development

# Firebase Configuration
# Path to your Firebase service account JSON file
FIREBASE_CREDENTIAL_PATH=serviceAccount.json

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Session Configuration
# Session timeout duration (e.g., 24h, 1h30m)
SESSION_TIMEOUT=24h
# Secret key for session encryption (change this in production!)
SESSION_SECRET=your-secret-key-change-this-in-production

# PostgreSQL Configuration
# Preferred for cloud deploys (Supabase pooler, includes SSL):
# POSTGRES_DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_DATABASE_URL=POSTGRES_DATABASE_URL=postgresql://postgres.tyywcogtfkqflwodxgsl:!roomease_dev!%21@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Fallback individual DB fields (used when POSTGRES_DATABASE_URL is empty)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DATABASE=roomease

# Analytics ML Bridge (V2)
ML_API_URL=http://localhost:5001
ML_API_PORT=5001
