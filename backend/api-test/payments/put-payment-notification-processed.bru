meta {
  name: Mark Payment Notification Processed
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/payment-notifications/{{notificationId}}/processed
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Cookie: session_id={{sessionId}}
}

auth:bearer {
  token: {{authToken}}
}

