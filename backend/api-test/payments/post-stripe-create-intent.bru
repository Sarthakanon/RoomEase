meta {
  name: Create Stripe Payment Intent
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/payment/stripe/create-intent
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Cookie: session_id={{sessionId}}
}

auth:bearer {
  token: {{authToken}}
}

