meta {
  name: Create Payment Notification
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/payment-notifications
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Cookie: session_id={{sessionId}}
}

auth:bearer {
  token: {{authToken}}
}

