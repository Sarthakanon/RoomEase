meta {
  name: Get Payment Notification By ID
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/payment-notifications/{{notificationId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Cookie: session_id={{sessionId}}
}

auth:bearer {
  token: {{authToken}}
}

