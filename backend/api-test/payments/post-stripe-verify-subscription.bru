meta {
  name: Verify Stripe Subscription
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/payment/stripe/subscription/verify
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Cookie: session_id={{sessionId}}
}

auth:bearer {
  token: {{authToken}}
}

