meta {
  name: Confirm Payment
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/roomspaces/{{roomspaceId}}/payments/{{paymentId}}/confirm
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Cookie: session_id={{sessionId}}
}

auth:bearer {
  token: {{authToken}}
}

