meta {
  name: Update Recurring Template
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/recurring-expenses/{{templateId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Cookie: session_id={{sessionId}}
}

auth:bearer {
  token: {{authToken}}
}

