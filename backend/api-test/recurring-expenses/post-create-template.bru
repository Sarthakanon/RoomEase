meta {
  name: Create Recurring Expense Template
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/recurring-expenses
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Cookie: session_id={{sessionId}}
}

auth:bearer {
  token: {{authToken}}
}

