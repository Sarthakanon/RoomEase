meta {
  name: Remove Roomspace Member
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/api/roomspaces/{{roomspaceId}}/members
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Cookie: session_id={{sessionId}}
}

auth:bearer {
  token: {{authToken}}
}

