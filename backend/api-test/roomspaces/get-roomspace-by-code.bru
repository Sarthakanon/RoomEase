meta {
  name: Search Roomspace By Code
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/roomspaces/code/{{inviteCode}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Cookie: session_id={{sessionId}}
}

auth:bearer {
  token: {{authToken}}
}

