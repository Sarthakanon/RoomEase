meta {
  name: Get Admin Roomspace Details
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/admin/roomspaces/{{roomspaceId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Cookie: session_id={{sessionId}}
}

auth:none {
  token: {{authToken}}
}

