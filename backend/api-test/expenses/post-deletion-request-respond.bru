meta {
  name: Respond To Deletion Request
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/deletion-requests/{{deletionRequestId}}/respond
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Cookie: session_id={{sessionId}}
}

auth:bearer {
  token: {{authToken}}
}

