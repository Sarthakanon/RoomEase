meta {
  name: Delete Personal Expense
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/api/personal-expenses/{{expenseId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Cookie: session_id={{sessionId}}
}

auth:bearer {
  token: {{authToken}}
}

