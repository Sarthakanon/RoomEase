meta {
  name: Mark Notification As Read
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/notifications/{{notificationId}}/read
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Cookie: session_id={{sessionId}}
}

auth:bearer {
  token: {{authToken}}
}

