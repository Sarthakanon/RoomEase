meta {
  name: Send Payment Reminder
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/notifications/send-reminder
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Cookie: session_id={{sessionId}}
}

auth:bearer {
  token: {{authToken}}
}

