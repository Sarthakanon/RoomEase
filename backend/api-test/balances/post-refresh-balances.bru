meta {
  name: Refresh Balance Cache
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/roomspaces/{{roomspaceId}}/balances/refresh
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Cookie: session_id={{sessionId}}
}

auth:bearer {
  token: {{authToken}}
}

