erDiagram
    USERS ||--o{ ROOMSPACES : creates
    USERS ||--o{ ROOMSPACE_MEMBERS : joins
    ROOMSPACES ||--o{ ROOMSPACE_MEMBERS : has

    ROOMSPACES ||--o{ EXPENSES : contains
    USERS ||--o{ EXPENSES : pays

    EXPENSES ||--o{ EXPENSE_SPLITS : split_into
    USERS ||--o{ EXPENSE_SPLITS : owes_share

    ROOMSPACES ||--o{ SETTLEMENTS : has
    USERS ||--o{ SETTLEMENTS : pays
    USERS ||--o{ SETTLEMENTS : receives

    ROOMSPACES ||--o{ PAYMENT_CONFIRMATIONS : has
    USERS ||--o{ PAYMENT_CONFIRMATIONS : submits
    USERS ||--o{ PAYMENT_CONFIRMATIONS : confirms

    USERS ||--o{ PERSONAL_EXPENSES : owns

    ROOMSPACES ||--o{ RECURRING_EXPENSE_TEMPLATES : has
    RECURRING_EXPENSE_TEMPLATES ||--o{ RECURRING_NOTIFICATIONS : generates

