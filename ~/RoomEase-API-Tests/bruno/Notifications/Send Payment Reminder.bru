meta {
  name: Send Payment Reminder
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/notifications/send-reminder
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "roomspace_id": "{{roomspace_id}}",
    "recipient_id": "{{other_user_id}}",
    "amount": 2405.2
  }
}
